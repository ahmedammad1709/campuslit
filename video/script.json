    "lines": [
      {
        "id": "hook",
        "text": "Four things wrong with the Bahria University Portal. All fixed.",
        "at": 0.5,
        "bot": true
      },
      {
        "id": "c1",
        "text": "One. It looks old.",
        "at": 5.15
      },
      {
        "id": "c1b",
        "text": "Now it looks like this.",
        "at": 9.05
      },
      {
        "id": "th1",
        "text": "Six themes. Or make your own.",
        "at": 12.15
      },
      {
        "id": "th2",
        "text": "Pick a colour, and the whole portal follows.",
        "at": 15.3
      },
      {
        "id": "c2",
        "text": "Two. Your timetable is a wide grid.",
        "at": 19.15
      },
      {
        "id": "c2b",
        "text": "Now it's a real calendar.",
        "at": 23.05
      },
      {
        "id": "c2c",
        "text": "Download it to your own calendar.",
        "at": 25
      },
      {
        "id": "c3",
        "text": "Three. Nothing reminds you.",
        "at": 31.15
      },
      {
        "id": "c3b",
        "text": "Now it counts down every deadline.",
        "at": 34.05
      },
      {
        "id": "c3c",
        "text": "And reminds you on every page.",
        "at": 36.75
      },
      {
        "id": "c4",
        "text": "Four. You can't search.",
        "at": 39.15
      },
      {
        "id": "c4b",
        "text": "Press Ctrl K, and search any page, on both portals.",
        "at": 42.05
      },
      {
        "id": "c5",
        "text": "Add it to Chrome in one click.",
        "at": 46.7
      },
      {
        "id": "cta",
        "text": "Campuslit. Free for Bahria students. Link in the comments.",
        "at": 49.55
      }
